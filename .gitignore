# Root gitignore consolidating backend + frontend

# --- .NET build artifacts ---
Beckend/**/bin/
Beckend/**/obj/
.vs/
*.user
*.csproj.user

# --- Node / Frontend ---
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# --- Secrets & config (review before removing) ---
**/secrets.json
**/*.secrets.json
.env
.env.*
appsettings.Development.json
# If appsettings.json contains secrets (API keys, connection strings) consider moving them to secrets.json or env vars.

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Misc ---
*.suo
*.ntvs*
*.njsproj
*.sw?
